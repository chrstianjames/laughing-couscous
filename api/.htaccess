# Route all non-file, non-dir requests to index.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache drops the Authorization header for PHP-CGI/FPM. Copy it into
    # HTTP_AUTHORIZATION so the API can read bearer tokens. (After an internal
    # rewrite it may also appear as REDIRECT_HTTP_AUTHORIZATION, which
    # config.php reads too.)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to JSON database files
    RewriteRule ^data/ - [F,L]
    # Block hidden / dot files
    RewriteRule (^|/)\. - [F,L]

    # Block PHP execution in uploads directory
    RewriteRule ^uploads/.*\.(php|phtml|phar|php[3-8]|pl|py|cgi|sh)$ - [F,L]

    # Route to index.php if request isn't a real file/dir
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Some hosts need this as well for CGI/FastCGI PHP
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Fallback when mod_rewrite is unavailable
<IfModule !mod_rewrite.c>
    FallbackResource /api/index.php
</IfModule>

# Upload limits for mod_php (PHP-CGI/FPM read api/.user.ini instead)
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 110M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_flag output_buffering Off
    php_flag zlib.output_compression Off
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 110M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_flag output_buffering Off
    php_flag zlib.output_compression Off
</IfModule>

# Prevent directory listing
Options -Indexes
