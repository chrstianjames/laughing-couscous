# Uploaded media is served straight by Apache (native byte-range support).
# Never execute anything in here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php[3-8]|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

# Correct MIME types so ExoPlayer / browsers recognise the streams
AddType video/mp4 .mp4 .m4v
AddType video/quicktime .mov
AddType video/webm .webm
AddType video/3gpp .3gp
AddType video/x-matroska .mkv
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/webp .webp

# Do not gzip video (breaks Content-Length / Range) and allow range requests
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "\.(mp4|m4v|mov|webm|3gp|mkv|jpg|jpeg|png|webp)$" no-gzip dont-vary
</IfModule>
<IfModule mod_headers.c>
    Header set Accept-Ranges bytes
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000"
</IfModule>
Options -Indexes
